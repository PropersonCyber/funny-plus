PG_URL=postgres://funnyplus:funnyplus@127.0.0.1:5434/funnyplus
PORT=8787

# ---- 高德 Web 服务（restapi.amap.com）----
# 只填 Web 服务 key；JS API key 不通用，混用会报 10009
AMAP_KEY=
# 控制台开了「数字签名」才必填；填了服务端每次请求都会带 sig
AMAP_SECRET=
# 需要真底图时才用（JS API key），当前地图仍是 SVG 示意，留空即可
AMAP_JS_KEY=

# ---- 三方登录（未配置时 /api/auth/status 报 enabled=false，前端隐藏登录入口）----
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 一键登录服务商未定：provider 填运营商/极光/阿里云等标识，接哪家都填这组
ONETAP_PROVIDER=
ONETAP_APP_KEY=
ONETAP_APP_SECRET=

# ---- AI 对话助手（未配置时 /api/ai/status 报 enabled=false，POST /api/chat 返回 503）----
# 走公司 ops-ai-gateway（OpenAI 兼容），不直连模型厂商；key 只在服务端，不要下发到客户端
AI_BASE_URL=https://ops-ai-gateway.yc345.tv/v1
AI_API_KEY=
# 换模型前先验证它支持 tool calling + 流式：对话助手靠工具收敛槽位，纯文本模型跑不起来
AI_MODEL=deepseek-v4.1-flash
