PG_URL=postgres://funnyplus:funnyplus@127.0.0.1:5434/funnyplus
PORT=8787

# ---- 高德 Web 服务（restapi.amap.com）----
# 只填 Web 服务 key；JS API key 不通用，混用会报 10009
AMAP_KEY=
# 控制台开了「数字签名」才必填；填了服务端每次请求都会带 sig
AMAP_SECRET=

# ---- 三方登录（未配置时 /api/auth/status 报 enabled=false，前端隐藏登录入口）----
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 一键登录服务商未定：provider 填运营商/极光/阿里云等标识，接哪家都填这组
ONETAP_PROVIDER=
ONETAP_APP_KEY=
ONETAP_APP_SECRET=

# ---- AI 对话助手（未配置时 /api/ai/status 报 enabled=false，POST /api/chat 返回 503）----
# 走公司 ops-ai-gateway（OpenAI 兼容），不直连模型厂商；key 只在服务端，不要下发到客户端
AI_BASE_URL=https://ops-ai-gateway.yc345.tv/v1
AI_API_KEY=
# 换模型前先验证它支持 tool calling + 流式：对话助手靠工具收敛槽位，纯文本模型跑不起来
AI_MODEL=deepseek-v4.1-flash

# ---- 模型单价（F10 成本口径；单位：元 / 百万 token）----
# 写死在代码里的话，对方调价后历史账单会被今天的单价重算，对不上账。
# 所以单价在这里配，费用在写入时折算成一笔固定值落库（ai_calls.cost_micros）。
# 没配时用一组兜底值，那只够让报表「不是 null」，不代表真实报价。
AI_PRICE_INPUT_PER_MTOK=1
AI_PRICE_OUTPUT_PER_MTOK=2
# 需要按模型区分时，把模型名转成大写、非字母数字换成下划线再加前后缀：
#   AI_PRICE_DEEPSEEK_V4_1_FLASH_INPUT=0.5
#   AI_PRICE_DEEPSEEK_V4_1_FLASH_OUTPUT=2

# ---- 开发用固定验证码（默认关闭）----
# 设为 1 时：任意手机号可用 123456 登录，且 GET /api/auth/dev-code 可读。
# 只能在本机开发环境开启；线上必须留空，否则等于任何人可登录任意账号。
AUTH_DEV_CODE=

# ---- 短信服务商（F06 第一条通道；未配置时发码接口返回 503，不会假装发出去）----
# 目前只接阿里云短信。四个变量缺一不可：少了签名名或模板号，请求发得出去但会被服务商拒
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
# 短信签名（控制台已审核通过的那个名字），不是模板名
SMS_SIGN_NAME=
# 模板 CODE，如 SMS_123456789；模板变量名必须是 code
SMS_TEMPLATE_CODE=
# 地域，默认 cn-hangzhou
SMS_REGION_ID=cn-hangzhou

# ---- Sign in with Apple（F06；未配置时 /api/auth/status 不列出这条通道）----
# 只需要 iOS bundle id：服务端用 Apple 公开 JWKS 本地验签，不请求 token 端点。
# 因此不需要 teamId / keyId / 私钥 —— 那几项是「服务端去换 token」才要的
APPLE_CLIENT_ID=
