{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@lynx-js/react",
    "types": [
      "@lynx-js/rspeedy/client"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@/*": [
        "../../web/src/*"
      ]
    },
    "rootDir": "../.."
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../../web/src/**/*.ts"
  ]
}